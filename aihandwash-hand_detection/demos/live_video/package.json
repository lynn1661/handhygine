{
  "name": "handposedetection_demo",
  "version": "0.0.1",
  "description": "Demo for hand pose detection api",
  "main": "index.js",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=8.9.0"
  },
  "dependencies": {
    "@mediapipe/hands": "~0.4.0",
    "@parcel/babel-preset-env": "2.9.3",
    "@tensorflow-models/hand-pose-detection": "file:../../dist",
    "@tensorflow/tfjs-backend-wasm": "^4.9.0",
    "@tensorflow/tfjs-backend-webgl": "^4.9.0",
    "@tensorflow/tfjs-converter": "^4.9.0",
    "@tensorflow/tfjs-core": "^4.9.0",
    "device-detector-js": "^3.0.3",
    "postcss-preset-env": "^6",
    "scatter-gl": "0.0.8",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2"
  },
  "scripts": {
    "create": "cd ../../ && mkdir dist",
    "watch": "cross-env NODE_ENV=development parcel index.html --no-hmr --open",
    "build": "cross-env NODE_ENV=production parcel build index.html --public-url ./"
  },
  "browser": {
    "crypto": false
  },
  "devDependencies": {
    "@babel/core": "^7.7.5",
    "@babel/plugin-transform-runtime": "^7.22.15",
    "@babel/preset-env": "^7.22.20",
    "@parcel/transformer-webmanifest": "^2.9.3",
    "babel-plugin-external-helpers": "^6.22.0",
    "babel-preset-env": "^1.7.0",
    "clang-format": "~1.2.2",
    "cross-env": "^5.2.1",
    "eslint": "^4.19.1",
    "eslint-config-google": "^0.9.1",
    "parcel": "^2.9.3",
    "parcel-bundler": "1.12.5",
    "parcel-plugin-static-files-copy": "^2.6.0",
    "postcss": "^8",
    "yalc": "~1.0.0-pre.50"
  },
  "resolutions": {
    "is-svg": "4.3.1"
  },
  "eslintConfig": {
    "extends": "google",
    "rules": {
      "require-jsdoc": 0,
      "valid-jsdoc": 0
    },
    "env": {
      "es6": true
    },
    "parserOptions": {
      "ecmaVersion": 8,
      "sourceType": "module"
    }
  },
  "eslintIgnore": [
    "dist/"
  ]
}
